    "test:cli": "npm run build && vitest run",
    "test:page": "npm run build && playwright test --project=chromium",
    "lint": "tsc --noEmit && eslint . --ignore-pattern .claude/",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "@types/proper-lockfile": "4.1.4",
    "diff2html": "3.4.56",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "highlight.js": "11.11.1",
    "markdown-it": "15.0.3",
    "proper-lockfile": "4.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
